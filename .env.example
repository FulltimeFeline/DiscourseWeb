# Optional: enable background Web Push notifications.
# All three must be set, and a Matrix push gateway (e.g. sygnal with the
# webpush pushkin) must be configured for the homeserver. Left unset, the app
# falls back to foreground-only notifications.
VITE_VAPID_PUBLIC_KEY=
VITE_PUSH_GATEWAY_URL=
VITE_PUSH_APP_ID=
